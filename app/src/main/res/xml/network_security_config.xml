<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- WebSocket signalling over wss, STUN/TURN over UDP/DTLS. Clear text is
         not needed since signalling and media both run over secure channels. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
