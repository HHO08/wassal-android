<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AppCompatActivity requires an AppCompat (or MaterialComponents) theme.
         Using a framework Theme.Material theme here caused an immediate crash
         on launch. -->
    <style name="Theme.Wassal" parent="Theme.AppCompat.Light.NoActionBar" />

    <style name="Theme.Wassal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B1220</item>
        <item name="postSplashScreenTheme">@style/Theme.Wassal</item>
    </style>
</resources>
